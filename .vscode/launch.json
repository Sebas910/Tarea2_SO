{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Depurar torneo (N=4, M=2)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/torneo_debug",
      "args": ["4", "2"],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "preLaunchTask": "Compilar (debug)",
      "setupCommands": [
        { "description": "Formato legible", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    },
    {
      "name": "Depurar torneo con config.txt (N=4, M=2)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/torneo_debug",
      "args": ["4", "2", "configs/config.txt"],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "preLaunchTask": "Compilar (debug)",
      "setupCommands": [
        { "description": "Formato legible", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    }
  ]
}
